# ============================================================================
# ICX STUDIOS PLATFORM — SELF-HOSTED ENVIRONMENT CONFIGURATION
# ============================================================================

# Server & Runtime
NODE_ENV=development
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Self-Hosted PostgreSQL 16+
DATABASE_URL=postgresql://icx_admin:icx_secret_password@localhost:5432/icx_studios
POSTGRES_USER=icx_admin
POSTGRES_PASSWORD=icx_secret_password
POSTGRES_DB=icx_studios
POSTGRES_PORT=5432
PG_POOL_MAX=25
PG_IDLE_TIMEOUT_MS=30000

# Self-Hosted Redis 7+
REDIS_URL=redis://:icx_redis_secret@localhost:6379/0
REDIS_PASSWORD=icx_redis_secret
REDIS_PORT=6379

# Authentication & Security Secrets (Generate with `openssl rand -hex 64` in prod)
JWT_ACCESS_SECRET=8f9a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a
JWT_REFRESH_SECRET=1a0f9e8d7c6b5a4f3e2d1c0b9a8f7e6d5c4b3a2f1e0d9c8b7a6f5e4d3c2b1a0f
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_SECONDS=604800
DOWNLOAD_HMAC_SECRET=9c8d7e6f5a4b3c2d1e0f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d

# Private File Storage Engine (Non-Public Disk Directory)
PRIVATE_STORAGE_ROOT=./storage/private
TUS_UPLOAD_DIR=./storage/private/tus-staging
WATERMARK_ASSET_PATH=./storage/private/system/watermark.png

# Paystack Payment Gateway (NGN)
PAYSTACK_SECRET_KEY=sk_test_replace_with_actual_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_replace_with_actual_paystack_public_key

# Email Provider (SMTP / Resend / Postmark)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_replace_with_actual_key
EMAIL_FROM=notifications@icxstudios.com

# Support
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000

